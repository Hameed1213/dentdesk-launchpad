{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dentdock-website",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  // Keep variables set in the Cloudflare dashboard when GitHub deploys run
  // (without this, each deploy wipes plain-text dashboard variables).
  "keep_vars": true,
}
